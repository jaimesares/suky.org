---
/**
 * Paw trails: dog and cat tracks crossing the screen.
 * They walk in from a random edge every few seconds, and on pointer down.
 */
---

<canvas id="trails" aria-hidden="true"></canvas>

<script>
	(() => {
		interface Step {
			x: number;
			y: number;
			angle: number;
			scale: number;
			cat: boolean;
			delay: number;
		}
		interface Trail {
			steps: Step[];
			startedAt: number;
		}

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);

		const canvas = document.getElementById('trails') as HTMLCanvasElement | null;
		const ctx = canvas?.getContext('2d');
		if (!canvas || !ctx) return;

		let trails: Trail[] = [];

		const resize = () => {
			canvas.width = Math.floor(window.innerWidth * dpr);
			canvas.height = Math.floor(window.innerHeight * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};
		resize();

		// One paw: central pad plus four toes. Cats are smaller and rounder.
		const drawPaw = (
			x: number,
			y: number,
			angle: number,
			scale: number,
			alpha: number,
			cat: boolean
		) => {
			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(angle);
			ctx.scale(scale, scale);
			ctx.globalAlpha = alpha;
			ctx.fillStyle = 'rgba(251,243,228,.62)';
			ctx.shadowColor = 'rgba(251,243,228,.45)';
			ctx.shadowBlur = 14;

			ctx.beginPath();
			if (cat) ctx.ellipse(0, 3.2, 7.0, 5.8, 0, 0, 6.2832);
			else ctx.ellipse(0, 3.4, 8.0, 6.6, 0, 0, 6.2832);
			ctx.fill();

			const toes = cat
				? [
						[-6.6, -5.6, 2.4],
						[-2.4, -8.8, 2.5],
						[2.4, -8.8, 2.5],
						[6.6, -5.6, 2.4],
					]
				: [
						[-7.8, -5.2, 3.0],
						[-2.9, -9.8, 3.1],
						[2.9, -9.8, 3.1],
						[7.8, -5.2, 3.0],
					];
			for (const [toeX, toeY, radius] of toes) {
				ctx.beginPath();
				ctx.ellipse(toeX!, toeY!, radius!, radius! * 1.18, 0, 0, 6.2832);
				ctx.fill();
			}
			ctx.restore();
		};

		const addTrail = (x: number, y: number, angle: number) => {
			const cat = Math.random() < 0.45;
			const scale = (cat ? 0.82 : 1.0) * (0.8 + Math.random() * 0.45);
			const stride = (cat ? 27 : 36) * scale;
			const steps: Step[] = [];
			let heading = angle;
			let px = x;
			let py = y;
			let side = 1;

			for (let i = 0; i < 18; i++) {
				heading += (Math.random() - 0.5) * 0.15;
				px += Math.cos(heading) * stride;
				py += Math.sin(heading) * stride;
				const nx = Math.cos(heading + Math.PI / 2);
				const ny = Math.sin(heading + Math.PI / 2);
				const offset = side * (cat ? 7 : 9) * scale;
				side *= -1;
				steps.push({
					x: px + nx * offset,
					y: py + ny * offset,
					angle: heading + Math.PI / 2,
					scale,
					cat,
					delay: i * 0.24,
				});
			}
			trails.push({ steps, startedAt: performance.now() / 1000 });
			if (trails.length > 5) trails.shift();
		};

		// Walks in from one of the four edges
		const addTrailFromEdge = () => {
			const width = window.innerWidth;
			const height = window.innerHeight;
			const edge = Math.floor(Math.random() * 4);
			let x: number, y: number, angle: number;

			if (edge === 0) {
				x = -40;
				y = Math.random() * height;
				angle = -0.5 + Math.random();
			} else if (edge === 1) {
				x = width + 40;
				y = Math.random() * height;
				angle = Math.PI - 0.5 + Math.random();
			} else if (edge === 2) {
				x = Math.random() * width;
				y = height + 40;
				angle = -Math.PI / 2 - 0.6 + Math.random() * 1.2;
			} else {
				x = Math.random() * width;
				y = -40;
				angle = Math.PI / 2 - 0.6 + Math.random() * 1.2;
			}
			addTrail(x, y, angle);
		};

		const draw = () => {
			const now = performance.now() / 1000;
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

			for (let i = trails.length - 1; i >= 0; i--) {
				const trail = trails[i]!;
				let alive = 0;
				for (const step of trail.steps) {
					const age = now - trail.startedAt - step.delay;
					if (age < 0) {
						alive++;
						continue;
					}
					const fadeIn = Math.min(age / 0.4, 1);
					const fadeOut = 1 - Math.min(Math.max((age - 5.5) / 3, 0), 1);
					const alpha = fadeIn * fadeOut;
					if (alpha <= 0.001) continue;
					alive++;
					drawPaw(step.x, step.y, step.angle, step.scale, alpha, step.cat);
				}
				if (alive === 0) trails.splice(i, 1);
			}
			requestAnimationFrame(draw);
		};

		const drawStatic = () => {
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
			trails = [];
			addTrailFromEdge();
			addTrailFromEdge();
			for (const trail of trails) {
				for (const step of trail.steps) {
					drawPaw(step.x, step.y, step.angle, step.scale, 0.55, step.cat);
				}
			}
		};

		window.addEventListener('resize', () => {
			resize();
			if (reducedMotion) drawStatic();
		});

		// Tap or click and an animal walks through
		window.addEventListener(
			'pointerdown',
			(event) => {
				if (reducedMotion) return;
				addTrail(event.clientX, event.clientY, Math.random() * Math.PI * 2);
			},
			{ passive: true }
		);

		if (reducedMotion) {
			drawStatic();
		} else {
			addTrailFromEdge();
			setTimeout(addTrailFromEdge, 2600);
			setInterval(addTrailFromEdge, 5200);
			requestAnimationFrame(draw);
		}
	})();
</script>
