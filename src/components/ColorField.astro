---
/**
 * Living background: a drifting colour field rendered with WebGL.
 * When the context is unavailable the body gets `no-webgl` and the CSS
 * gradient fallback defined in global.css takes over.
 */
---

<canvas id="field" aria-hidden="true"></canvas>

<script>
	(() => {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const fallback = () => document.body.classList.add('no-webgl');

		const canvas = document.getElementById('field') as HTMLCanvasElement | null;
		if (!canvas) return;

		const gl = (canvas.getContext('webgl', { antialias: false, alpha: false }) ??
			canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
		if (!gl) return fallback();

		const vertexSource = 'attribute vec2 pos; void main(){ gl_Position = vec4(pos,0.0,1.0); }';

		const fragmentSource = `precision highp float;
uniform vec2 u_res; uniform float u_time; uniform vec2 u_pointer;

const vec3 NIGHT = vec3(0.047,0.078,0.094);
const vec3 MOSS  = vec3(0.122,0.435,0.361);
const vec3 HONEY = vec3(0.949,0.627,0.239);
const vec3 CORAL = vec3(0.949,0.392,0.353);
const vec3 CREAM = vec3(0.984,0.953,0.894);

float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453123); }
float noise(vec2 p){
  vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f);
  return mix(mix(hash(i),hash(i+vec2(1.0,0.0)),u.x),
             mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),u.x),u.y);
}
float fbm(vec2 p){
  float v=0.0,a=0.5; mat2 m=mat2(1.62,1.20,-1.20,1.62);
  for(int i=0;i<5;i++){ v+=a*noise(p); p=m*p; a*=0.5; } return v;
}

void main(){
  vec2 uv = (gl_FragCoord.xy - 0.5*u_res)/min(u_res.x,u_res.y);
  float t = u_time * 0.55;
  vec2 p = uv*1.22 + u_pointer*0.18;

  vec2 q = vec2(fbm(p + t*0.07), fbm(p + vec2(5.2,1.3) - t*0.05));
  vec2 r = vec2(fbm(p + 2.6*q + vec2(1.7,9.2) + t*0.09),
               fbm(p + 2.6*q + vec2(8.3,2.8) - t*0.075));
  float f = fbm(p + 2.2*r);
  float band = clamp(f*1.32 + 0.20*length(r) - 0.05, 0.0, 1.0);

  vec3 col = mix(NIGHT, MOSS, smoothstep(0.04,0.56,band));
  col = mix(col, HONEY, smoothstep(0.46,0.90,band)*0.90);
  col = mix(col, CORAL, smoothstep(0.54,1.00,r.y*1.30)*0.55);
  col = mix(col, CREAM, pow(smoothstep(0.80,1.0,band),2.0)*0.30);

  // thin fibres: the field is combed like an animal's coat
  float fur = sin(uv.y*34.0 + r.x*24.0 + q.x*11.0);
  col += 0.030 * fur * smoothstep(0.22,0.92,band);

  float d = length(uv*vec2(0.84,1.0));
  col *= 1.0 - 0.60*smoothstep(0.32,1.32,d);
  col += (hash(gl_FragCoord.xy + t) - 0.5)/255.0;
  gl_FragColor = vec4(col,1.0);
}`;

		const compile = (type: number, source: string) => {
			const shader = gl.createShader(type);
			if (!shader) return null;
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
		};

		const vertexShader = compile(gl.VERTEX_SHADER, vertexSource);
		const fragmentShader = compile(gl.FRAGMENT_SHADER, fragmentSource);
		if (!vertexShader || !fragmentShader) return fallback();

		const program = gl.createProgram();
		if (!program) return fallback();
		gl.attachShader(program, vertexShader);
		gl.attachShader(program, fragmentShader);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return fallback();
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const position = gl.getAttribLocation(program, 'pos');
		gl.enableVertexAttribArray(position);
		gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

		const uRes = gl.getUniformLocation(program, 'u_res');
		const uTime = gl.getUniformLocation(program, 'u_time');
		const uPointer = gl.getUniformLocation(program, 'u_pointer');

		const resize = () => {
			const width = Math.floor(canvas.clientWidth * dpr);
			const height = Math.floor(canvas.clientHeight * dpr);
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
				gl.viewport(0, 0, width, height);
			}
			gl.uniform2f(uRes, canvas.width, canvas.height);
		};
		window.addEventListener('resize', resize);

		const target = [0, 0];
		const current = [0, 0];
		window.addEventListener(
			'pointermove',
			(event) => {
				target[0] = (event.clientX / window.innerWidth - 0.5) * 2;
				target[1] = (0.5 - event.clientY / window.innerHeight) * 2;
			},
			{ passive: true }
		);

		let startedAt = performance.now();
		let clock = 0;
		let visible = true;

		const render = (now: number) => {
			if (!visible) return;
			resize();
			clock = (now - startedAt) / 1000;
			current[0] += (target[0] - current[0]) * 0.03;
			current[1] += (target[1] - current[1]) * 0.03;
			gl.uniform1f(uTime, clock);
			gl.uniform2f(uPointer, current[0], current[1]);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
			if (!reducedMotion) requestAnimationFrame(render);
		};

		document.addEventListener('visibilitychange', () => {
			visible = !document.hidden;
			if (visible && !reducedMotion) {
				startedAt = performance.now() - clock * 1000;
				requestAnimationFrame(render);
			}
		});

		if (reducedMotion) {
			resize();
			gl.uniform1f(uTime, 9.0);
			gl.uniform2f(uPointer, 0, 0);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		} else {
			requestAnimationFrame(render);
		}

		canvas.addEventListener('webglcontextlost', (event) => {
			event.preventDefault();
			fallback();
		});
	})();
</script>
