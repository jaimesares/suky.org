---
import Base from '../layouts/Base.astro';
---

<Base
	title="suky.org — Estamos trabajando en ello"
	description="suky.org está en construcción. Estamos trabajando en ello."
	ogTitle="suky.org"
	ogDescription="Estamos trabajando en ello."
>
	<main>
		<h1 class="brand">suky<span class="tld">.org</span></h1>
		<p class="status">Estamos trabajando en ello</p>
		<div class="bar" role="presentation"><span></span></div>
		<p class="note">
			¿Eres una asociación de animales? Con <strong>SukyCMS</strong> puedes crear la web de tu
			protectora y gestionar animales, adopciones y donaciones. Es gratis, siempre.{' '}
			<a href="https://sukycms.com" rel="noopener">Conocer SukyCMS</a>
		</p>
	</main>
</Base>

<style>
	main {
		position: relative;
		z-index: 4;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(1.5rem, 4vw, 2.4rem);
		padding: 8vh 6vw;
		text-align: center;
		animation: breathe 7.5s ease-in-out infinite;
	}
	@keyframes breathe {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.012);
		}
	}

	.brand {
		font-family: var(--display);
		font-weight: 800;
		font-size: clamp(3.2rem, 14.5vw, 9.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--cream);
		text-shadow: 0 0 60px rgba(12, 20, 24, 0.55);
	}
	.brand .tld {
		font-weight: 500;
		color: var(--honey);
	}

	.status {
		font-weight: 500;
		font-size: clamp(0.68rem, 2.4vw, 0.8rem);
		text-transform: uppercase;
		letter-spacing: 0.34em;
		text-indent: 0.34em;
		color: rgba(251, 243, 228, 0.78);
	}

	.bar {
		position: relative;
		width: min(280px, 60vw);
		height: 1px;
		background: rgba(251, 243, 228, 0.16);
		overflow: hidden;
	}
	.bar span {
		position: absolute;
		inset: 0 auto 0 0;
		width: 38%;
		background: linear-gradient(90deg, transparent, var(--honey), var(--coral), transparent);
		animation: advance 4s cubic-bezier(0.66, 0, 0.34, 1) infinite;
	}
	@keyframes advance {
		0% {
			transform: translateX(-100%);
		}
		100% {
			transform: translateX(260%);
		}
	}

	.note {
		margin-top: clamp(1.2rem, 5vh, 3rem);
		max-width: 38ch;
		font-size: clamp(0.86rem, 2.9vw, 0.95rem);
		line-height: 1.55;
		color: rgba(251, 243, 228, 0.62);
	}
	.note strong {
		font-weight: 600;
		color: rgba(251, 243, 228, 0.86);
	}
	.note a {
		display: inline-block;
		margin-top: 0.55rem;
		font-weight: 600;
		color: var(--honey);
		text-decoration: none;
		border-bottom: 1px solid rgba(242, 160, 61, 0.4);
		padding-bottom: 1px;
		transition:
			color 0.25s ease,
			border-color 0.25s ease;
	}
	.note a:hover,
	.note a:focus-visible {
		color: var(--cream);
		border-color: var(--cream);
	}
	.note a:focus-visible {
		outline: 2px solid var(--cream);
		outline-offset: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		main {
			animation: none;
		}
		.bar span {
			animation: none;
			transform: translateX(28%);
		}
	}
</style>
